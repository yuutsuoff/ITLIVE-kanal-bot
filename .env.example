# ===== Database (PostgreSQL) =====
# Format: postgresql+asyncpg://username:password@host:port/database_name
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/itlive_hr

# Individual DB fallback variables (if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=itlive_hr

